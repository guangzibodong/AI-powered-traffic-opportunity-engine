{
  "name": "trafscope",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "repository": {
    "type": "git",
    "url": "https://github.com/guangzibodong/AI-powered-traffic-opportunity-engine.git"
  },
  "scripts": {
    "dev:web": "pnpm --filter @trafscope/web run dev",
    "build:web": "pnpm --filter @trafscope/web run build",
    "lint:web": "pnpm --filter @trafscope/web run lint",
    "test:web": "pnpm --filter @trafscope/web run test:ui-contract",
    "test:api": "cd apps/api && python -B -m unittest discover app/tests"
  },
  "workspaces": [
    "apps/web",
    "packages/shared"
  ]
}
